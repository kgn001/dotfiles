#!/usr/bin/env bash
# ----- interactive guard -----
case $- in
	*i*) ;;
	*) return ;;
esac

# ----- Appearance -----

# ----- OS Detection -----
case "$(uname -s)" in
	Darwin) 
		OS="mac" ;
		export STARSHIP_OS_COLOR="light blue" ;;
	Linux)  
		OS="linux" ;
		export STARSHIP_OS_COLOR="orange" ;;
esac

# ----- Host checker -----
host_file="$HOME/.config/bash/hosts/${HOSTNAME%%.*}.sh"
[[ -f $host_file ]] && source "$host_file"

# ----- HomeBrew (Mac only) -----
if [[ $OS == "mac" ]] && [[ -x /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ----- PATH -----
for dir in "$HOME/.local/bin" "$HOME/.local/scripts"; do
	case ":$PATH:" in
		*":$dir:"*) ;;
		*) PATH="$dir:$PATH" ;;
	esac
done
unset dir
export PATH

# ----- History -----
HISTCONTROL=ignoredups:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend

# ----- Note function -----
note() {
	local dir="$HOME/notes"
	local file="$dir/$(date +%Y-%m)-$(hostname -s).md"
	local day="$(date '+%a %d')"
	mkdir -p "$dir"
	grep -qs "^## $day\$" "$file" || printf '\n## %s\n\n' "$day" >> "$file"
	printf -- '- %s %s\n' "$(date +%H:%M)" "$*" >> "$file"
}

# ----- Defaults -----
export EDITOR=nvim
export VISUAL=nvim

# ----- Aliases -----

# Git Aliases
alias gaa='git add .'
alias gcm='git commit -m'
alias gpsh='git push'
alias gs='git status'

